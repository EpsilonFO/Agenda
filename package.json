{
  "name": "agenda-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Agenda personnel moderne piloté par un agent IA (modèle au choix via providall : LLM_MODEL)",
  "scripts": {
    "clean": "rm -rf .next",
    "predev": "rm -rf .next",
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset": "node -e \"const fs=require('fs');const events=JSON.parse(fs.readFileSync('data/events.json','utf8'));const kept=events.filter(e=>e.source!=='plan');fs.writeFileSync('data/events.json',JSON.stringify(kept,null,2));fs.writeFileSync('data/plans.json','[]');console.log('events :',events.length,'→',kept.length,'| plans vidés');\""
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@xenova/transformers": "^2.17.2",
    "next": "14.2.5",
    "providall": "github:EpsilonFO/providall#v0.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "^4.1.10"
  }
}
