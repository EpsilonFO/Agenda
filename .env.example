# ================================ MODÈLE LLM ================================
# Les appels passent par providall (github.com/EpsilonFO/providall) :
# LE SEUL RÉGLAGE À CHANGER POUR BASCULER DE MODÈLE, c'est LLM_MODEL. Renseigne
# la clé du fournisseur choisi plus bas, et c'est tout : l'URL, le protocole et
# les capacités suivent.
#
# Valeurs acceptées : un alias du registre —
#   anthropic  opus · sonnet · haiku · fable · opus-4.8 · sonnet-4.6
#   openai     gpt-luna · gpt-terra
#   deepseek   ds-flash · ds-pro          mistral  mistral · mistral-medium
#   gemini     gemini-flash · gemini-pro  xai      grok · grok-fast
#   moonshot   kimi-k2.7 · kimi-k3        zai      glm · glm-flash
#   openrouter or-glm · or-kimi
# — ou la forme `fournisseur:identifiant` pour un modèle trop récent pour y
# figurer (ex. zai:glm-5.4-flash). `npx providall models` liste le registre.
#
# Avec UNE SEULE clé posée ci-dessous, LLM_MODEL est même facultatif : c'est le
# modèle par défaut de ce fournisseur qui sert.
LLM_MODEL=gpt-terra

# --- Clés API : seule celle du fournisseur du modèle actif est lue ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# GEMINI_API_KEY= · XAI_API_KEY= · MOONSHOT_API_KEY= · ZAI_API_KEY=
# OPENROUTER_API_KEY= · GROQ_API_KEY=

# Un modèle par rôle si besoin (prioritaire sur LLM_MODEL).
# LLM_MODEL_PLANNER=   # Josiane (agenda) : raisonnement spatio-temporel
# LLM_MODEL_COACH=     # Jannik (sport)
# LLM_MODEL_WORK=      # Emilien (travail)
# LLM_MODEL_LEISURE=   # Djimo (loisir)
# LLM_MODEL_CHEF=      # Simone (cuisine)
# LLM_MODEL_SMALL=     # boucle de chat, résumés, titres de session

# --- Serveur OpenAI-compatible quelconque (Ollama, vLLM, un proxy…) ---
# Ex. Ollama local : LLM_MODEL=openai_compat:qwen2.5:14b (clé facultative).
# LLM_BASE_URL=
# LLM_API_KEY=
# <PROVIDER>_BASE_URL surcharge un fournisseur connu (proxy d'entreprise).

# --- Réglages fins (facultatifs) ---
# Effort de raisonnement : none|low|medium|high|xhigh|max. Ramené à l'échelle du
# fournisseur (OpenAI s'arrête à `high`), ignoré par les modèles sans ce réglage.
LLM_EFFORT=xhigh
# LLM_EFFORT_CHAT=medium                # boucle de chat, résumés, titres : plus léger. `none` coupe le raisonnement (DeepSeek : thinking désactivé)
# LLM_EFFORT_RETOUCH=high               # retouche ciblée d'un plan
# LLM_MAX_TOKENS=8192                   # plafond de sortie (défaut : celui du modèle)
# LLM_TIMEOUT_MS=600000                 # timeout d'un appel
# LLM_RETRIES=2                         # retries sur erreur transitoire (429/5xx)
# LLM_DEBUG=1                           # journalise chaque appel : jetons, coût, latence
# PLANNER_TRACE=1                       # écrit chaque séance du planificateur dans data/traces/*.json (diagnostic)

# Dictée vocale locale (Whisper via transformers.js, exécuté dans le navigateur).
# Optionnel — valeurs par défaut ci-dessous. Modèles plus légers : Xenova/whisper-tiny,
# plus précis : Xenova/whisper-small. La langue accélère et fiabilise la transcription.
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base
NEXT_PUBLIC_WHISPER_LANG=french

# --- Notifications push (Web Push / VAPID) ---
# Génère tes clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.com

# Préavis des rappels, en minutes, du plus lointain au plus proche.
# Défaut : 20,1 — un rappel 20 min avant pour se préparer, un dernier 1 min avant.
REMINDER_LEAD_MIN=20,1

# Secret partagé cron <-> /api/cron/reminders (en-tête Authorization: Bearer <secret>).
CRON_SECRET=

# --- Authentification par passkey (WebAuthn / Face ID) ---
# rpID = domaine exact (sans schéma ni port), ex. agenda.mondomaine.fr. En local : localhost
WEBAUTHN_RP_ID=localhost
# Origin complet, ex. https://agenda.mondomaine.fr. En local : http://localhost:3111
WEBAUTHN_ORIGIN=http://localhost:3111
# Secret de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# Code exigé pour enrôler un nouvel appareil (une fois par appareil) : openssl rand -hex 4
ENROLL_CODE=
SESSION_DAYS=30
# true = désactive complètement l'auth passkey (accès direct à l'agenda).
# DÉVELOPPEMENT LOCAL UNIQUEMENT — jamais en prod.
AUTH_DISABLED=false

# --- Google Calendar (optionnel, voir GOOGLE.md) ---
# Identifiants OAuth « Application Web » créés dans la console Google Cloud.
# Sans eux, la section Google Calendar des réglages reste inactive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection, EXACTEMENT celle déclarée dans la console. Par défaut :
# WEBAUTHN_ORIGIN + /api/google/callback (ex. http://localhost:3002/api/google/callback).
# GOOGLE_REDIRECT_URI=
# Fuseau des événements de l'agenda (les ISO locaux sans fuseau sont lus dans ce fuseau).
# GOOGLE_TIMEZONE=Europe/Paris
# Passage automatique toutes les N minutes (défaut 5).
# GOOGLE_SYNC_INTERVAL_MIN=5
# Fenêtre glissante synchronisée, en jours (défauts : 14 en arrière, 90 en avant).
# GOOGLE_SYNC_PAST_DAYS=14
# GOOGLE_SYNC_FUTURE_DAYS=90
